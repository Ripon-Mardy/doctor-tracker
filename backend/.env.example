# Port the Express API listens on (src/server.ts). Defaults to 5000.
PORT=5000

# Frontend origin allowed by CORS with credentials (src/server.ts).
FRONTEND_URL=http://localhost:3000

# MongoDB connection string, local or Atlas (src/config/database.ts). Required.
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# Secret used to sign auth JWTs (src/utils/jwt.ts). Required, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters

# JWT lifetime (src/utils/jwt.ts). Defaults to 1d.
JWT_EXPIRES_IN=1d

# Set to "production" to mark the auth cookie as Secure (src/controllers/auth.controller.ts).
NODE_ENV=development

# Used only by `npm run seed:admin` (scripts/seed-admin.ts) to create the first admin.
ADMIN_NAME=Demo Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=change_me
